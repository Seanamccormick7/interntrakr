# apps/api/.env.example

# Server configuration
PORT=4000
NODE_ENV=development

# JWT Secret
JWT_SECRET=replace-me-with-secure-secret

# Database Engine: "mongo" or "postgres"
DB_ENGINE=mongo

# MongoDB connection (used when DB_ENGINE=mongo)
MONGO_URI=mongodb://localhost:27017/interntrackr

# PostgreSQL connection (used when DB_ENGINE=postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interntrackr

# Redis connection
REDIS_URL=redis://localhost:6379

# Spring Boot Scoring Service
SCORE_SERVICE_URL=http://localhost:8080


INTERNAL_API_KEY=generate-secure-key-for-production

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000