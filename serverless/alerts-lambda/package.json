{
  "name": "@serverless/alerts-lambda",
  "version": "0.2.0",
  "private": true,
  "description": "Nightly alerts lambda: polls upcoming deadlines and sends email via SES.",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/handler.cjs",
  "scripts": {
    "clean": "rimraf dist alerts-lambda.zip",
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/handler.cjs --external:@aws-sdk/*",
    "zip": "node -e \"const fs=require('fs');const archiver=require('archiver');const output=fs.createWriteStream('alerts-lambda.zip');const archive=archiver('zip');output.on('close',()=>console.log('Created alerts-lambda.zip'));archive.pipe(output);archive.directory('dist/',false);archive.finalize();\"",
    "package": "npm run clean && npm run build && npm run zip",
    "local:run": "node -e \"const {handler}=require('./dist/handler.cjs'); handler({},{}).then(console.log).catch(console.error)\"",
    "lint": "eslint src --ext .ts",
    "test": "jest --forceExit"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.705.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "archiver": "^7.0.1",
    "esbuild": "^0.23.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.6",
    "typescript": "^5.0.0"
  }
}
